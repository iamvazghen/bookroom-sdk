# Bookroom SDK - configuration template
#
# Copy to `.env` and fill in your own values. NEVER commit the filled-in file.
#
# Only two values are required:
#   GEMINI_API_KEY     - the LLM provider key
#   TYPESAFE_API_KEY   - the JEv review key (omit to run without review)

# ---------------------------------------------------------------------------
# Required: the LLM provider
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Required for review: JEv (TypeSafe)
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
JEV_ENABLED=true
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# ---------------------------------------------------------------------------
# Where the Book Summarizer engine lives.
# The Python SDK drives this application in-process, so it needs its path.
# ---------------------------------------------------------------------------
BOOKROOM_APP_ROOT=D:\summarizer\src

# ---------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------
MIN_WORD_COUNT=200
OCR_ENABLED=true
OCR_LANGUAGE=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------------------------------------------------------------------------
# Filesystem
# ---------------------------------------------------------------------------
OUTPUT_DIR=output
SOURCE_RETENTION_HOURS=0
OUTPUT_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Budget caps (per work batch)
# ---------------------------------------------------------------------------
MAX_ESTIMATED_GEMINI_INPUT_TOKENS=2000000
MAX_ESTIMATED_JEV_CREDITS=20000
MAX_ACTUAL_GEMINI_TOKENS=2000000

# ---------------------------------------------------------------------------
# Review tuning (optional)
# ---------------------------------------------------------------------------
JEV_SCORE_THRESHOLD=3.5
JEV_CONFIDENCE_THRESHOLD=0.55
JEV_MAX_REVISIONS=2
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_RETRIES=5

# ---------------------------------------------------------------------------
# HTTP facade (for TypeScript / React / Next.js / other-language clients).
# The facade process holds the two keys above; clients send only this token.
# ---------------------------------------------------------------------------
# BOOKROOM_HOST=127.0.0.1
# BOOKROOM_PORT=8787
# BOOKROOM_FACADE_TOKEN=generate-a-long-random-string
