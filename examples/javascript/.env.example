# Where the facade is listening. Defaults to http://127.0.0.1:8787.
BOOKROOM_URL=http://127.0.0.1:8787

# The facade's own bearer token. Required only if you started the server with
# --token. It is a secret: keep it in this process's environment and never send
# it to a browser, a client bundle, or a NEXT_PUBLIC_ variable.
BOOKROOM_FACADE_TOKEN=

# Optional: a book to summarize, so you can omit --path.
BOOKROOM_PATH=/books/attention.epub