# Where the facade is listening. Defaults to http://127.0.0.1:8787.
BOOKROOM_URL=http://127.0.0.1:8787

# The facade's own bearer token, read by server.mjs only. Required only if you
# started the server with --token. It is a secret: this Node process is the only
# thing that may see it. Never put it in a VITE_ variable, since everything
# prefixed VITE_ is inlined into the browser bundle.
BOOKROOM_FACADE_TOKEN=

# Optional: where the Vite dev server should forward /api/bookroom. Defaults to
# http://127.0.0.1:8788, which is where server.mjs listens.
BOOKROOM_PROXY_URL=http://127.0.0.1:8788