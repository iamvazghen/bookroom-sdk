# Where the facade is listening. Defaults to http://127.0.0.1:8787.
BOOKROOM_URL=http://127.0.0.1:8787

# The facade's own bearer token. Server-only: read by getServerBookroom() inside
# a route handler or a server action. Never prefix it with NEXT_PUBLIC_, which
# would inline it into the browser bundle, and never read it in a client
# component. Required only if you started the facade with --token.
BOOKROOM_FACADE_TOKEN=

# Optional: a book to try immediately.
BOOKROOM_PATH=/books/attention.epub