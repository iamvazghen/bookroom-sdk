{
  "name": "bookroom-sdk",
  "version": "2.0.0",
  "description": "SDK for the Bookroom book summarizer: EPUB/PDF extraction, complete study guides, independent JEv review, and Markdown/PDF/JSON exports. Python, TypeScript, JavaScript, React and Next.js.",
  "keywords": [
    "book-summary",
    "summarizer",
    "book-summarizer",
    "study-guide",
    "ebook",
    "epub",
    "pdf",
    "llm",
    "gemini",
    "jev",
    "book-review",
    "concept-map",
    "knowledge-extraction",
    "reading-notes",
    "study-notes",
    "book-notes",
    "document-analysis",
    "text-extraction",
    "ocr",
    "rag",
    "retrieval-augmented-generation",
    "evaluation",
    "quality-gate",
    "sdk",
    "react",
    "nextjs",
    "nextjs-api-routes",
    "server-actions",
    "typescript",
    "javascript"
  ],
  "license": "MIT",
  "author": "Vazghen Vardanian",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/esm/index.d.ts",
        "require": "./dist/cjs/index.d.ts",
        "default": "./dist/esm/index.d.ts"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react.d.ts",
      "import": "./dist/esm/react.js",
      "default": "./dist/esm/react.js"
    },
    "./next": {
      "types": "./dist/esm/next.d.ts",
      "import": "./dist/esm/next.js",
      "default": "./dist/esm/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "python",
    "tools",
    "run_summary.py",
    "run_baseline.py",
    "compare_runs.py",
    "SKILL.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "!python/dist",
    "!python/build",
    "!python/*.egg-info",
    "!**/__pycache__",
    "!**/*.pyc",
    "!**/.DS_Store"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamvazghen/bookroom-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/iamvazghen/bookroom-sdk/issues"
  },
  "homepage": "https://github.com/iamvazghen/bookroom-sdk#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.esm.json && tsc -p tsconfig.build.cjs.json && node scripts/finalize-dist.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pretest": "npm run build",
    "test": "node --test test/client.test.js test/interop.test.js",
    "facade": "bookroom serve --port 8787",
    "verify:python": "python verify_sdk.py && python verify_facade.py && python verify_examples.py",
    "verify:clean-install": "python verify_clean_install.py",
    "verify:ts": "python verify_typescript.py",
    "example:typescript": "node --experimental-strip-types examples/typescript/src/study-guide.ts",
    "example:javascript": "node examples/javascript/src/study-guide.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2"
  }
}
